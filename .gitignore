#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# Normal rules (sorted alphabetically)
#
.*
!.checkpatch.conf
*.a
*.asn1.[ch]
*.bin
*.bin[_.]*
*.cfgout
*.cover
*.dtb
*.dtbo
*.dtb.S
*.dtb.clean.dts
*.dtb.diff
*.dtb.full.dts
*.elf
*.exe
*.fit
*.gcda
*.gcno
*.i
*.img
*.itb
*.lex.c
*.lst
*.map
*.mod.c
*.mbx
*.o
*.o.*
*.order
*.patch
*.pem
*.s
*.su
*.swp
*.tab.[ch]
*.ti-*
# Build tree
/build*

#
# Top-level generic files
#
fit-dtb.blob*
/MLO*
/SPL*
/System.map
/boards.cfg
/mkimage*mkimage
/mkimage-in-simple-bin*
/simple-bin*
/u-boot*
/*.log

#
# We don't want to ignore the following even if they are dot-files
#
!.clang-format
!.get_maintainer.*
!.gitattributes
!.gitignore
!.mailmap

#
# Generated files
#
/spl/
/tpl/
/vpl/
/defconfig
/generated_defconfig
/Test*
/capsule*.efi-capsule
/capsule*.map
/keep-syms-lto.*
/*imx8mimage*
/*imx8mcst*
/*rcar4-sa0*
/drivers/video/u_boot_logo.bmp.S
/test/fdt_overlay/test-fdt-overlay-stacked.dtbo.S
/test/fdt_overlay/test-fdt-overlay.dtbo.S
capsule_esl_file

#
# Generated include files
#
/include/autoconf.mk*
/include/config.h
/include/config/
/include/generated/
/include/bmp_logo.h
/include/bmp_logo_data.h

# stgit generated dirs
patches-*
.stgit-edit.txt

# quilt's files
patches
series

# gdb files
.gdb_history

# cscope files
cscope.*

# tags files
/tags
/ctags
/etags

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

*.orig
*~
\#*#

# Python cache
__pycache__

# Python code coverage output (python3-coverage html)
/htmlcov/

# pylint files
/pylint.cur
/pylint.out/

# qconfig database
/qconfig.db

# Clang's compilation database file
/compile_commands.json

#
# SoCFPGA workspace-local files (lab artefacts, personal scripts, scan
# output). None of these belong in the upstream tree; gitignored so
# `git status` stays clean while developers iterate.
#

# Quartus / FPGA programming artefacts (never source)
*.sof
*.rpd
*.rbf
*.pfg
*.jic
*.wic
*.crt
*.hex
output_file*

# Personal per-target build scripts (kept on disk, not shared)
/compile.sh
/compile_uboot_*.sh
/agilex.sh
/agilex5.sh
/arria10.sh
/km.sh
/rsu_test.sh
/run.sh
/env.sh

# Documents, presentations, datasheets at repo root
/*.pdf
/*.pptx
/*.potx
/*.xml

# Local vulnerability / dump-tool output
vuln_scan*.py
vuln_scan*.json
vuln_scan*.txt
getdt.out
final.dts
compare.dts
serv_req_info.txt

# Coverity / coverage build directories
/cov_config/
/cov_out/

# Compiled native ASan/UBSan harness binaries (sources stay tracked)
/test_asan/*/rsu_asan_test
/test_asan/*/*.o

# Vendor / lab tooling that lives in-tree but is never source we ship
/km_5909/
/workspace/
/hps_isw_handoff/
/arch/arm/mach-socfpga/craft_spt.py
/arch/arm/mach-socfpga/cv_bsp_generator/
/arch/arm/mach-socfpga/vuln_scan_report.json
